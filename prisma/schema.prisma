datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ACCOUNT_HOLDER
  AUDITOR
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  TREASURY
  ESCROW
  SETTLEMENT_CLEARING
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum AccountRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum AuditStatus {
  SUCCESS
  FAILURE
  WARNING
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecurityEventType {
  FAILED_LOGIN
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  BRUTE_FORCE_DETECTED
  UNAUTHORIZED_ACCESS
  RATE_LIMIT_VIOLATION
  MFA_SETUP
  MFA_FAILED
  MFA_VERIFIED
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_SUCCESS
  SESSION_REVOKED
  PERMISSION_MODIFIED
  SYSTEM_BOOTSTRAP
  LEDGER_INTEGRITY_CHECK
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

model User {
  id                     String              @id @default(uuid())
  email                  String              @unique
  passwordHash           String
  fullName               String
  role                   Role                @default(ACCOUNT_HOLDER)
  isActive               Boolean             @default(true)
  
  // Cybersecurity & Brute-Force Protection
  failedLoginAttempts    Int                 @default(0)
  lockoutUntil           DateTime?
  mfaSecret              String?
  mfaEnabled             Boolean             @default(false)
  passwordResetToken     String?
  passwordResetExpires   DateTime?

  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  accounts               Account[]
  permissions            AccountPermission[]
  initiatedTransactions  Transaction[]       @relation("Initiator")
  auditLogs              AuditLog[]
  securityEvents         SecurityEvent[]
  accountRequests        AccountRequest[]    @relation("UserAccountRequests")
  reviewedAccountRequests AccountRequest[]   @relation("AdminReviewedRequests")

  @@index([email])
  @@index([role])
  @@index([lockoutUntil])
  @@index([passwordResetToken])
}

model Account {
  id                    String              @id @default(uuid())
  accountNumber         String              @unique
  name                  String
  type                  AccountType         @default(CHECKING)
  balance               Decimal             @default(0.0000) @db.Decimal(18, 4)
  currency              String              @default("USD")
  status                AccountStatus       @default(ACTIVE)
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  permissions           AccountPermission[]
  outgoingTransactions  Transaction[]       @relation("SourceAccount")
  incomingTransactions  Transaction[]       @relation("DestinationAccount")
  ledgerEntries         LedgerEntry[]
  accountRequests       AccountRequest[]

  @@index([userId])
  @@index([accountNumber])
  @@index([status])
}

model AccountPermission {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  canView     Boolean  @default(true)
  canDeposit  Boolean  @default(true)
  canWithdraw Boolean  @default(false)
  canTransfer Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, accountId])
  @@index([userId])
  @@index([accountId])
}

model Transaction {
  id                    String            @id @default(uuid())
  referenceNumber       String            @unique
  idempotencyKey        String?           @unique
  type                  TransactionType
  amount                Decimal           @db.Decimal(18, 4)
  fee                   Decimal           @default(0.0000) @db.Decimal(18, 4)
  currency              String            @default("USD")
  status                TransactionStatus @default(PENDING)
  description           String?
  metadata              Json?

  sourceAccountId       String?
  sourceAccount         Account?          @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: SetNull)

  destinationAccountId  String?
  destinationAccount    Account?          @relation("DestinationAccount", fields: [destinationAccountId], references: [id], onDelete: SetNull)

  initiatedById         String
  initiatedBy           User              @relation("Initiator", fields: [initiatedById], references: [id], onDelete: Restrict)

  ledgerEntries         LedgerEntry[]

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([referenceNumber])
  @@index([idempotencyKey])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([initiatedById])
  @@index([status])
  @@index([createdAt])
}

model LedgerEntry {
  id              String          @id @default(uuid())
  transactionId   String
  transaction     Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entryType       LedgerEntryType
  amount          Decimal         @db.Decimal(18, 4)
  balanceAfter    Decimal         @db.Decimal(18, 4)
  createdAt       DateTime        @default(now())

  @@index([transactionId])
  @@index([accountId])
  @@index([entryType])
  @@index([createdAt])
}

model IdempotencyRecord {
  id             String    @id @default(uuid())
  key            String    @unique
  userId         String
  requestPath    String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime  @default(now())
  expiresAt      DateTime

  @@index([key])
  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id                    String            @id @default(uuid())
  action                String
  resource              String
  resourceId            String?
  userId                String?
  user                  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress             String?
  userAgent             String?
  status                AuditStatus       @default(SUCCESS)
  metadata              Json?
  createdAt             DateTime          @default(now())

  @@index([action])
  @@index([resource])
  @@index([userId])
  @@index([createdAt])
}

model SecurityEvent {
  id                    String            @id @default(uuid())
  eventType             SecurityEventType
  severity              SecuritySeverity  @default(LOW)
  details               String
  userId                String?
  user                  User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress             String?
  userAgent             String?
  metadata              Json?
  resolved              Boolean           @default(false)
  createdAt             DateTime          @default(now())

  @@index([eventType])
  @@index([severity])
  @@index([userId])
  @@index([createdAt])
}

model AccountRequest {
  id               String               @id @default(uuid())
  userId           String
  user             User                 @relation("UserAccountRequests", fields: [userId], references: [id], onDelete: Cascade)
  accountName      String
  accountType      AccountType          @default(CHECKING)
  requestedBalance Decimal              @default(0.0000) @db.Decimal(18, 4)
  currency         String               @default("USD")
  reason           String?
  status           AccountRequestStatus @default(PENDING)
  adminRemarks     String?
  reviewedById     String?
  reviewedBy       User?                @relation("AdminReviewedRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  createdAccountId String?
  createdAccount   Account?             @relation(fields: [createdAccountId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([reviewedById])
}
