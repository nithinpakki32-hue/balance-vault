# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/balancevault?schema=public

# Redis Configuration (Used for distributed rate-limiting & session locks)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# If REDIS_URL is provided, it takes precedence
# REDIS_URL=redis://default:password@localhost:6379

# Authentication & Security
JWT_SECRET=balance-vault-ultra-secure-jwt-secret-key-32-chars-min
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # 100 requests per window
AUTH_RATE_LIMIT_MAX=10       # 10 auth attempts per window

# Initial SuperAdmin Credentials (used during prisma/seed.ts)
DEFAULT_ADMIN_EMAIL=admin@balancevault.com
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_NAME=System Administrator
