# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL - Neon / RDS / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/balancevault?schema=public

# Redis Configuration (Distributed rate limiting & session blacklisting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# If REDIS_URL is provided, it takes precedence
# REDIS_URL=rediss://default:password@host:6379

# Authentication & JWT Security (Must be at least 32 characters in production)
JWT_SECRET=replace-with-a-cryptographically-secure-random-32-char-secret-string!
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# Mandatory Distinct Administrator Bootstrap Secret (Must be at least 16 characters in production)
ADMIN_BOOTSTRAP_SECRET=replace-with-a-unique-secret-key-for-first-admin-bootstrap-only!

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes window
RATE_LIMIT_MAX_REQUESTS=100   # 100 requests per window
AUTH_RATE_LIMIT_MAX=15        # 15 auth requests per window
